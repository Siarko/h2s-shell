{
    "id": "nixos",
    "label": "NixOS",
    "matches": ["nixos"],
    "markers": ["/etc/NIXOS"],
    "etcManaged": true,
    "helper": "package",
    "builtinModules": "package",
    "programDirectories": ["/run/current-system/sw/bin"],
    "setuidWrapperDirectory": "/run/wrappers/bin",
    "pamDirectories": ["/etc/pam.d"],
    "pamModuleDirectories": ["/run/current-system/sw/lib/security/"],
    "networkManagerVpnDirectories": ["/run/current-system/sw/lib/NetworkManager/VPN", "/etc/NetworkManager/VPN"],
    "polkitRulesDirectory": "/etc/polkit-1/rules.d",
    "polkitRulesInstallable": false,
    "packages": {
        "nerdFont": { "option": "programs.h2s-shell.enable", "package": "nerd-fonts.jetbrains-mono", "in": "fonts.packages" },
        "fprintd": { "option": "services.fprintd.enable" },
        "pamU2f": { "option": "security.pam.u2f.enable" }
    }
}
