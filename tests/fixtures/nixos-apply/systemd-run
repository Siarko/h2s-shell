#!/bin/sh
# Stand-in for systemd-run (NixosApplyScriptTest): records its options, then runs the command
# after "--" and answers with its exit.
base=${0%/run/current-system/sw/bin/systemd-run}
words=
while [ $# -gt 0 ] && [ "$1" != -- ]; do words="$words $1"; shift; done
printf 'systemd-run%s\n' "$words" >> "$base/log/calls"
[ $# -gt 0 ] || exit 2
shift
exec "$@"
