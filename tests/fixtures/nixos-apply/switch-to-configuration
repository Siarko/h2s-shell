#!/bin/sh
# Stand-in for a built system's switch-to-configuration (NixosApplyScriptTest): records its
# words, says a line, exits as ctl/switch.code says.
base=${0%/nix/store/*}
printf 'switch %s\n' "$*" >> "$base/log/calls"
echo "activating the configuration..."
exit "$(cat "$base/ctl/switch.code")"
