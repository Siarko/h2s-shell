#!/bin/sh
# The command the fixture's suite runs as "root":
#   talk lines <n> <seconds>   prints "line 1" … "line <n>", <seconds> apart, then a line on stderr
#   talk sleep <seconds>       prints "started", then sleeps (TERM ends it at once)
#   talk term <file> <seconds> prints "started", then sleeps; TERM ends it at once with exit
#                              42 (a code no signal gives), creating <file> first (removed at
#                              the start): that the TERM reached it and it ended by itself
#   talk hold <seconds>        prints "started", then sleeps ignoring TERM (as a process run as
#                              root, which the shell cannot signal: only KILL ends it here)
#   talk env <name>            prints "<name>=<value>" from its environment ("" when unset)
case "$1" in
    env)
        eval "value=\${$2-}"
        echo "$2=$value"
        ;;
    lines)
        i=1
        while [ "$i" -le "$2" ]; do
            echo "line $i"
            i=$((i + 1))
            if [ "$i" -le "$2" ]; then sleep "$3"; fi
        done
        echo "to stderr" >&2
        ;;
    sleep)
        echo started
        exec sleep "$2"
        ;;
    term)
        rm -f -- "$2"
        trap 'kill "$child" 2> /dev/null; : > "$2"; exit 42' TERM
        echo started
        sleep "$3" &
        child=$!
        wait "$child"
        ;;
    hold)
        trap '' TERM
        echo started
        sleep "$2"
        ;;
esac
