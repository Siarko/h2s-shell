#!/bin/sh
# Stands in for pkexec in the fixture's suite (module test mode: the manifest's testPrograms,
# so module.programs.pkexec is this file, and the shell's queue runs nothing else as pkexec).
# Prints the words it was given on stderr, one per line after "pkexec:", then runs them —
# unless the program it is handed (the word after the shell's `timeout -k <s> <limit>`) is
# named "dismiss" (exit 126, as pkexec for a dismissed prompt) or "refuse" (127, not
# authorised). Prints PRIVILEGED_FIXTURE from its environment as "pkexec-env:<value>" on stderr
# (module.privileged.start's options.environment, test mode only).
# PRIVILEGED_MARK: a file it creates when it runs at all, for a suite to see that it did not.
# PRIVILEGED_EXIT_MARK: it runs the words as a child instead, passes a TERM on to it (as pkexec
# does), and writes the child's exit status to that file: how a cancelled run ended, which the
# answer to a module does not say.
if [ -n "${PRIVILEGED_MARK-}" ]; then : > "$PRIVILEGED_MARK"; fi
for word; do printf 'pkexec:%s\n' "$word" >&2; done
printf 'pkexec-env:%s\n' "${PRIVILEGED_FIXTURE-}" >&2
case "${5##*/}" in
    dismiss) exit 126 ;;
    refuse) exit 127 ;;
esac
if [ -n "${PRIVILEGED_EXIT_MARK-}" ]; then
    rm -f -- "$PRIVILEGED_EXIT_MARK"
    termed=""
    "$@" &
    child=$!
    trap 'termed=1; kill -TERM "$child" 2> /dev/null' TERM
    wait "$child"
    status=$?
    # A wait cut short by the TERM: the child's own status comes with the next
    if [ -n "$termed" ]; then
        wait "$child"
        status=$?
    fi
    echo "$status" > "$PRIVILEGED_EXIT_MARK"
    exit "$status"
fi
exec "$@"
