#!/bin/sh
# A stand-in for gdbus (tests/LogindSleepReadingTest.qml), started through a link in the
# suite's scratch directory; no bus is reached. It answers logind's CanSuspend, CanHibernate
# and CanSuspendThenHibernate with that directory's `can-suspend`, `can-hibernate` and
# `can-suspend-then-hibernate` (failing as gdbus does without one), the Manager's IdleAction
# and IdleActionUSec properties from `idle-action` ("<action> <microseconds>"; failing
# without it), and takes Suspend, SuspendThenHibernate and Hibernate: each call noted in
# `calls` with its name and argument, answered "()" — or refused, status 1, while a `refuse`
# file is there. With a `hang` file it never ends. Anything else it is asked fails.
here=$(dirname "$0")
case " $* " in
    *" call --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 "*) ;;
    *) echo "Error: the stand-in only knows logind's Manager on the system bus" >&2; exit 2 ;;
esac
[ -f "$here/hang" ] && exec sleep 30
for argument in "$@"; do last=$argument; done
case " $* " in
    *" --method org.freedesktop.login1.Manager.CanSuspend "*)
        [ -f "$here/can-suspend" ] || { echo "Error: GDBus.Error:org.freedesktop.DBus.Error.ServiceUnknown: no logind" >&2; exit 1; }
        echo "('$(cat "$here/can-suspend")',)"
        ;;
    *" --method org.freedesktop.login1.Manager.CanHibernate "*)
        [ -f "$here/can-hibernate" ] || { echo "Error: GDBus.Error:org.freedesktop.DBus.Error.ServiceUnknown: no logind" >&2; exit 1; }
        echo "('$(cat "$here/can-hibernate")',)"
        ;;
    *" --method org.freedesktop.login1.Manager.CanSuspendThenHibernate "*)
        [ -f "$here/can-suspend-then-hibernate" ] || { echo "Error: GDBus.Error:org.freedesktop.DBus.Error.ServiceUnknown: no logind" >&2; exit 1; }
        echo "('$(cat "$here/can-suspend-then-hibernate")',)"
        ;;
    *" --method org.freedesktop.DBus.Properties.Get org.freedesktop.login1.Manager IdleAction "*)
        [ -f "$here/idle-action" ] || { echo "Error: GDBus.Error:org.freedesktop.DBus.Error.ServiceUnknown: no logind" >&2; exit 1; }
        read -r action usec < "$here/idle-action"
        echo "(<'$action'>,)"
        ;;
    *" --method org.freedesktop.DBus.Properties.Get org.freedesktop.login1.Manager IdleActionUSec "*)
        [ -f "$here/idle-action" ] || { echo "Error: GDBus.Error:org.freedesktop.DBus.Error.ServiceUnknown: no logind" >&2; exit 1; }
        read -r action usec < "$here/idle-action"
        echo "(<uint64 $usec>,)"
        ;;
    *" --method org.freedesktop.login1.Manager.Suspend "*|*" --method org.freedesktop.login1.Manager.SuspendThenHibernate "*|*" --method org.freedesktop.login1.Manager.Hibernate "*)
        for argument in "$@"; do
            case $argument in org.freedesktop.login1.Manager.*) method=${argument#org.freedesktop.login1.Manager.} ;; esac
        done
        echo "$method $last" >> "$here/calls"
        if [ -f "$here/refuse" ]; then
            echo "Error: GDBus.Error:org.freedesktop.login1.OperationInProgress: There's already a shutdown or sleep operation in progress" >&2
            exit 1
        fi
        echo "()"
        ;;
    *) echo "Error: the stand-in does not know this call" >&2; exit 2 ;;
esac
