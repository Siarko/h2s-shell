#!/bin/sh
# A stand-in for hyprctl (tests/ScreenPowerReadingTest.qml), started through a link in the
# suite's scratch directory: `-j monitors` prints that directory's `monitors.json` (waits
# while `read-wait` is there, fails while `read-fails` is); `dispatch <expression>` appends
# the expression to `dispatches`, makes `after-dispatch.json` (when there) the new
# `monitors.json`, and prints "ok" — as Hyprland does whatever it did — or fails with
# status 1 while `dispatch-fails` is there. Anything else it is asked fails.
here=$(dirname "$0")
case "$1 $2" in
    "-j monitors")
        while [ -e "$here/read-wait" ]; do sleep 0.02; done
        if [ -e "$here/read-fails" ]; then
            echo "HYPRLAND_INSTANCE_SIGNATURE was not set! (Is Hyprland running?)" >&2
            exit 1
        fi
        cat "$here/monitors.json" ;;
    "dispatch "*)
        [ $# -eq 2 ] || { echo "the stand-in takes one expression" >&2; exit 2; }
        printf '%s\n' "$2" >> "$here/dispatches"
        if [ -e "$here/dispatch-fails" ]; then
            echo "Couldn't connect to the Hyprland socket" >&2
            exit 1
        fi
        [ ! -e "$here/after-dispatch.json" ] || mv "$here/after-dispatch.json" "$here/monitors.json"
        echo "ok" ;;
    *) echo "the stand-in only knows -j monitors and dispatch" >&2; exit 2 ;;
esac
