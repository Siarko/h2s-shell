# The test bed's "password" method: accepts exactly the test password, nothing else.
#
# Placeholders (@...@) are filled in by lib.sh. Module paths are absolute because the
# store keeps each module in its own package. The shape matters: pam_exec failing is not
# an authentication failure (PAM would report a system error, which the shell shows as
# "not available"), so a failing check skips nothing and lands on pam_deny, which is
# what a wrong password from pam_unix looks like; a passing one jumps over it.
#
# The first line is the lock's marker, as in the shipped pam/password: pam_echo's message
# says that pam_start got through loading the modules (the shell never shows it). A start
# with no word from PAM is stuck before any module ran — rare, more so under load — and
# the shell starts it again (LockRules, timings.firstWord); without the marker such a
# start waits for the 90 s verify bound and the test fails.
auth     [default=ignore] @PAM_MODULES@/pam_echo.so h2s-shell-lock.started
auth     [success=1 default=ignore] @PAM_MODULES@/pam_exec.so quiet expose_authtok @WORK@/pam/check-password.sh
auth     requisite @PAM_MODULES@/pam_deny.so
auth     required  @PAM_MODULES@/pam_permit.so
account  required  @PAM_MODULES@/pam_permit.so
