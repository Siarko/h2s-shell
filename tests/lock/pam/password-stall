# The test bed's "password" method behind the lock's marker line, with a module that can
# stay silent (stall.sh): a stand-in for a PAM check stuck before its first module, and for
# a module that waits without a word after the marker.
#
# The marker line names pam_echo through marker/pam_echo.so, which the test or stall.sh
# links to libpam's own: while the link is missing, libpam cannot load it and goes on
# without it ([default=ignore]), so that start says no marker — as a child stuck inside
# pam_start says nothing. The rest is pam/password's shape (see there).
auth     [default=ignore] @WORK@/pam/marker/pam_echo.so h2s-shell-lock.started
auth     [default=ignore] @PAM_MODULES@/pam_exec.so quiet @WORK@/pam/stall.sh
auth     [success=1 default=ignore] @PAM_MODULES@/pam_exec.so quiet expose_authtok @WORK@/pam/check-password.sh
auth     requisite @PAM_MODULES@/pam_deny.so
auth     required  @PAM_MODULES@/pam_permit.so
account  required  @PAM_MODULES@/pam_permit.so
