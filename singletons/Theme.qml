pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick
import Qt.labs.folderlistmodel

// Every visual value the shell uses, read as Theme.<token>. The values come from the theme
// the active profile picks ("appearance.theme"): a JSON file in
// ~/.config/h2s_shell/themes/<name>.json, layered over the built-in values below, with its
// `extends` chain and an optional palette file (`colorsFrom`, e.g. generated by matugen).
// Theme files and palettes are watched, so a change applies at once. See
// docs/plans/themes.md and ThemeRules.
//
// Colours are named by role rather than by where they were first used, so a theme — or a
// generated palette — can set each one meaningfully. Variants with transparency are
// derived here with Qt.alpha from the base colours, not set by themes.
Singleton {
    id: root

    // ---- The built-in theme: today's look, and every token a theme file may set ----
    readonly property var builtin: ({
        "colors": {
            // Backgrounds
            "barBackground": "#4b4b4b",      // the bar
            "popupBackground": "#4d4d4d",    // popups and their curved corners
            "surface": "#3b3b3b",            // an element: bar cell, card, field, row
            "surfaceHover": "#5a5a5a",       // an element under the pointer, or whose popup is open
            "scrim": "#000000",              // behind the screensaver and lock screen
            // Accent
            "accent": "#44d47a",             // selection, active state, progress, graphs
            "accentHover": "#92db7a",        // accent under the pointer
            "accentDark": "#008000",         // filled accent: focused workspace, code buttons
            "onAccent": "#ffffff",           // text and icons on the accent
            "accentSecondary": "#5aa9e6",    // a second series or highlight: upload, sidebar selection
            // Text, brightest to dimmest
            "textPrimary": "#ffffff",        // labels, headings, the clock
            "textSecondary": "#aaaaaa",      // secondary labels, body text
            "textMuted": "#888888",          // timestamps, links, empty states
            "textDisabled": "#777777",       // disabled, other-month days, faint icons
            // Status
            "error": "#e05555",              // errors, destructive actions
            "warning": "#e8a854",            // warnings, volume above 100%
            "success": "#44d47a",            // connected, done
            // Workspaces
            "workspaceActive": "#4a6a4a",    // active but not focused
            "workspaceSpecial": "#7a1a2a",   // a shown special (scratchpad) workspace
            // Calendar
            "calendarToday": "#666666",      // the circle behind today's date
            // Filled buttons
            "confirm": "#1e5c1e",            // confirming: add an event
            "confirmHover": "#2d6a2d",
            "confirmSecondary": "#1e3a5f",   // confirming a change: save an edited event
            "confirmSecondaryHover": "#2d4a6d",
            // Borders, drawn where their width is above 0
            "barBorder": "#777777",
            "capsuleBorder": "#777777",
            "popupBorder": "#777777",
            "osdToastBorder": "#777777",
            "osdVolumeBorder": "#777777",
            "osdMessageBorder": "#777777"
        },
        "fonts": {
            "family": "JetBrainsMono Nerd Font",
            "sizeTiny": 9,                   // smallest form labels
            "sizeXSmall": 10,                // very small secondary labels
            "sizeSmall": 11,                 // metadata, timestamps, captions
            "sizeBody": 12,                  // default body text
            "sizeBodyLarge": 13,             // slightly larger body/labels
            "sizeMedium": 14,                // subheadings, medium text
            "sizeSection": 16,               // panel section icons, calendar headers
            "sizeHeading": 18,               // settings section headers, widget text
            "sizeTitle": 20,                 // widget/panel titles, large icons
            "sizeDisplay": 22,               // calendar event display
            "sizeLargeDisplay": 24,          // music panel headers
            "sizeXXLargeDisplay": 32,        // music track name
            "sizeHero": 52                   // notification empty-state icon
        },
        // The bar's geometry (ThemeRules.barTokens): pixels, and corner radii in percent
        // of half the bar's height
        "bar": {
            "barHeight": 36,                 // the bar itself
            "reservedSpace": 40,             // space kept free for it at the top of the screen
            "topOffset": 2,                  // between the bar and the top of the screen
            "leftMargin": 0,                 // between the screen edges and the bar
            "rightMargin": 0,
            "leftPadding": 5,                // between the bar's ends and its widgets
            "rightPadding": 5,
            "radiusTopLeft": 0,
            "radiusTopRight": 0,
            "radiusBottomLeft": 20,
            "radiusBottomRight": 20,
            "cellVerticalMargin": 5,         // above and below each widget's cell
            "widgetSpacing": 5,              // between the widgets of a section
            "borderWidth": 0                 // along the edge facing the desktop (colour barBorder); 0: none
        },
        // Radii, borders and spacing by kind of element (docs/plans/themes-stage7.md). Radii
        // and sizes in pixels.
        "capsule": { "radius": 5, "horizontalPadding": 8, "borderWidth": 0 },   // a widget's cell on the bar
        "workspace": { "pillRadius": 4, "pillHorizontalPadding": 4, "pillHeight": 22, "pillSpacing": 4 },
        "tray": { "pillRadius": 5, "pillWidth": 24, "iconSize": 18, "pillSpacing": 4 },  // the tray's icons
        "popup": { "radius": 20, "contentPadding": 10, "borderWidth": 0 },
        "row": { "radius": 6, "horizontalPadding": 8 },                       // rows and cards in popups
        "listItem": { "radius": 4 },                                          // menu and list items
        "dropdown": { "radius": 6 },
        "powerMenu": { "buttonRadius": 8, "buttonHeight": 44 },
        "button": { "radius": 6, "horizontalPadding": 7, "verticalPadding": 4, "minHeight": 24 },
        "saveButton": { "radius": 6 },
        "cancelButton": { "radius": 6 },
        "deleteButton": { "radius": 6 },
        "iconButton": { "radius": 4 },
        "pill": { "radius": 6, "horizontalPadding": 7, "minHeight": 22 },
        "field": { "radius": 6, "horizontalPadding": 8 },
        "notificationCard": { "radius": 8, "padding": 8, "controlRadius": 5 },  // in the panel
        "osdToast": { "radius": 8, "padding": 10, "width": 360, "screenGap": 16, "spacing": 8, "badgeWidth": 36, "borderWidth": 0 },
        "osdVolume": { "radius": 6, "padding": 10, "borderWidth": 0 },
        // The shell's message pill; a radius of -1 rounds its ends fully
        "osdMessage": { "radius": -1, "borderWidth": 0 },
        "tooltip": { "radius": 4, "horizontalPadding": 8, "verticalPadding": 6 },
        "settings": { "pageMargin": 14, "sidebarItemRadius": 6, "tabRadius": 6, "tabHorizontalPadding": 12, "cardRadius": 6 },
        "calendar": { "dayRadius": 4 },
        "checkbox": { "radius": 3 },
        "lock": { "cardRadius": 16, "controlRadius": 8, "controlHeight": 40 },
        "border": { "width": 1, "selectedWidth": 2 },  // ordinary outlines; selection rings
        // Animations by role — the kind of motion, not where it happens (docs/plans/themes.md)
        "durations": {
            "hover": 100,                    // colour under the pointer
            "state": 150,                    // a switch, a focused workspace, a field's state
            "expand": 150,                   // something growing or shrinking in place
            "popup": 100,                    // a popup opening or closing
            "popupResize": 100,              // a popup moving to another widget's size
            "enter": 250,                    // a toast, an OSD or a card arriving
            "exit": 200,                     // and leaving
            "move": 200,                     // a small shift: toasts restacking
            "slide": 300,                    // a larger slide: menus, pages
            "fade": 150,                     // appearing or disappearing in place
            "value": 400,                    // a value bar following its data
            "heartbeat": 350,                // the wave on graphs when a sample arrives
            "pop": 380,                      // a mark popping in; "Clear all" is timed from it
            "pulse": 1000,                   // one breath of a pulsing indicator
            "spin": 800,                     // one turn of a spinner
            "themeChange": 400               // colours moving to a new theme
        },
        "curves": {
            "hover": "OutQuad",
            "state": "OutQuad",
            "expand": "OutQuad",
            "popupOpen": "OutQuad",
            "popupClose": "InQuad",
            "popupResize": "OutQuad",
            "enter": "OutCubic",
            "exit": "InCubic",
            "move": "OutCubic",
            "slide": "OutCubic",
            "fade": "OutQuad",
            "value": "Linear",
            "heartbeat": "OutQuad",
            "pop": "OutBack",
            "pulse": "InOutQuad",
            "spin": "Linear",
            "themeChange": "OutQuad"
        }
    })

    // ---- Resolution ----
    // The theme the active profile picks, and the one shown: that, unless a theme is being
    // previewed from the settings window (a test, saved nowhere)
    readonly property string profileTheme: Profiles.value("appearance.theme") || "default"
    property string preview: ""
    readonly property string themeName: preview !== "" ? preview : profileTheme
    // Where theme files live, next to the config
    readonly property string themesDir: Config.path.toString().replace(/^file:\/\//, "")
        .replace(/\/[^\/]*$/, "") + "/themes"
    // The curves library, shared by every theme (ThemeRules, "Curves")
    readonly property string curvesPath: _folder(themesDir) + "/curves.json"
    // Drafts: changes made in the settings, not saved yet, one file per theme
    // (ThemeRules, "Drafts")
    readonly property string draftsDir: _folder(themesDir) + "/theme-drafts"

    // The resolved values, the chain that produced them, and what went wrong (missing
    // themes, cycles, unreadable files) — for the settings page to show
    property var values: builtin
    property var chain: []
    property var errors: []
    // Counts reloads: bind to it to follow any theme file, not only the active theme's
    // (valuesOf)
    property int revision: 0
    // Files the resolution read that exist, watched for changes; and the folders of every
    // file it looked for, watched so a theme or palette created later is noticed
    property var _watched: []
    property var _watchedFolders: []

    onThemeNameChanged: Qt.callLater(reload)
    // Previewing the theme in use changes no name, only whether its draft shows
    onPreviewChanged: Qt.callLater(reload)
    Component.onCompleted: {
        reload();
        if (!Config.readOnly)
            _ensureThemesDir.running = true;
        _migrateBarLayoutIfNeeded();
    }

    function _path(file) {
        return file.startsWith("~/") ? Quickshell.env("HOME") + file.slice(1) : file;
    }

    function _folder(path) {
        return path.replace(/\/[^\/]*$/, "");
    }

    // Reads and parses a JSON file; null when it is missing or broken, adding why to
    // `errors` if given
    function _read(path, errors) {
        _reader.path = path;
        // The reader keeps what it read last for an unchanged path
        _reader.reload();
        const text = _reader.text();
        if (text === "")
            return null;
        try {
            return JSON.parse(text);
        } catch (error) {
            errors?.push(path + ": " + error.message);
            return null;
        }
    }

    // Resolves the theme `name`: { values, chain, errors, watched, folders }
    // `withDraft`: the theme `name` with its draft laid over it — what the settings show,
    // and the shell while it is previewed
    function _resolve(name, withDraft) {
        const draft = withDraft ? drafts[name] : undefined;
        // Local, not a property: a property written and read here would make any binding
        // that ends up calling this loop
        const readErrors = [];
        const watched = [];
        const folders = [themesDir];
        const readWatched = path => {
            const parsed = _read(path, readErrors);
            // A broken file is watched too, so fixing it applies
            if (_reader.text() !== "")
                watched.push(path);
            if (!folders.includes(_folder(path)))
                folders.push(_folder(path));
            return parsed;
        };
        const result = ThemeRules.chainFor(name, themeName => {
            const parsed = readWatched(_themePath(themeName));
            return themeName === name && draft ? ThemeRules.applyDraft(parsed ?? {}, draft) : parsed;
        });
        const palettes = {};
        for (const entry of result.chain) {
            if (typeof entry.theme.colorsFrom !== "string")
                continue;
            const path = _path(entry.theme.colorsFrom);
            const palette = readWatched(path);
            if (palette === null)
                result.errors.push("Palette \"" + path + "\" of theme \"" + entry.name + "\" not found");
            else
                palettes[entry.name] = palette.colors ?? palette;
        }
        // The curves library, read with the theme, so a change to either reloads both
        const library = readWatched(curvesPath) ?? {};
        const values = ThemeRules.resolve(builtin, result.chain, palettes);
        for (const role in values.curves) {
            const curve = ThemeRules.curveEasing(values.curves[role], library);
            if (curve.error !== "")
                result.errors.push(curve.error + " (role \"" + role + "\")");
        }
        // What the draft sets is marked as such; a value it resets keeps where its
        // inherited value comes from, marked as reset
        const origins = ThemeRules.origins(result.chain, palettes);
        for (const group in draft ?? {}) {
            for (const token in draft[group]) {
                if (!origins[group])
                    continue;
                if (draft[group][token] === null)
                    origins[group][token] = Object.assign({}, origins[group][token] ?? {}, { reset: true });
                else
                    origins[group][token] = { theme: name, palette: false, draft: true };
            }
        }
        return {
            values: values,
            origins: origins,
            library: library,
            chain: result.chain.map(entry => entry.name),
            errors: result.errors.concat(readErrors),
            watched: watched,
            folders: folders
        };
    }

    function reload() {
        const resolved = _resolve(themeName, preview !== "");
        // A new theme, or a file changed by something else (matugen after a wallpaper
        // change), fades the colours over; the shell's own edits and the first load do not
        if (revision > 0 && !_quietReload
                && JSON.stringify(resolved.values.colors) !== JSON.stringify(values.colors)) {
            _colorsAnimating = true;
            _colorsAnimatingEnd.interval = duration("themeChange") + 50;
            _colorsAnimatingEnd.restart();
        }
        _quietReload = false;
        values = resolved.values;
        origins = resolved.origins;
        if (JSON.stringify(resolved.library) !== JSON.stringify(curveLibrary))
            curveLibrary = resolved.library;
        const easings = {};
        for (const role in values.curves)
            easings[role] = ThemeRules.curveEasing(values.curves[role], curveLibrary).easing;
        _curveEasings = easings;
        chain = resolved.chain;
        errors = resolved.errors;
        for (const error of errors)
            console.warn("[Theme]", error);
        if (JSON.stringify(resolved.watched) !== JSON.stringify(_watched))
            _watched = resolved.watched;
        if (JSON.stringify(resolved.folders) !== JSON.stringify(_watchedFolders))
            _watchedFolders = resolved.folders;
        // Every theme file, parsed, for where curves are used and for managing themes; and
        // every name in the folder, including files that do not parse
        const allThemes = {};
        const allNames = [];
        for (let i = 0; i < _themeFiles.count; i++) {
            const name = _themeFiles.get(i, "fileBaseName");
            allNames.push(name);
            const theme = _read(_themePath(name));
            if (theme !== null)
                allThemes[name] = theme;
        }
        themeFiles = allThemes;
        allNames.sort((a, b) => a.localeCompare(b));
        if (JSON.stringify(allNames) !== JSON.stringify(themeNames))
            themeNames = allNames;
        // Any file may have changed, and with it the other themes asked for
        const others = {};
        const otherErrors = {};
        const otherOrigins = {};
        for (const other in _otherValues) {
            const otherResolved = _resolve(other, true);
            others[other] = otherResolved.values;
            otherErrors[other] = otherResolved.errors;
            otherOrigins[other] = otherResolved.origins;
        }
        _otherErrors = otherErrors;
        _otherOrigins = otherOrigins;
        _otherValues = others;
        revision++;
    }

    // The resolved values of any theme, for editing one that is not active; bind to
    // `revision` alongside to follow changes. Themes other than the active one are
    // resolved outside the caller's binding and kept: FileView.text() is reactive, so
    // reading a chain of files inside a binding re-triggered it file by file — a binding
    // loop. Until a theme's values are ready (a moment later), the active ones stand in.
    function valuesOf(name) {
        if (_showsDraftOf(name))
            return values;
        const known = _otherValues[name];
        if (known === undefined) {
            Qt.callLater(_resolveOther, name);
            return values;
        }
        return known;
    }

    property var _otherValues: ({})
    property var _otherErrors: ({})
    property var _otherOrigins: ({})
    // Where the active theme's values come from (ThemeRules.origins)
    property var origins: ({})

    function _resolveOther(name) {
        if (name in _otherValues)
            return;
        const resolved = _resolve(name, true);
        const others = Object.assign({}, _otherValues);
        others[name] = resolved.values;
        const otherErrors = Object.assign({}, _otherErrors);
        otherErrors[name] = resolved.errors;
        _otherErrors = otherErrors;
        const otherOrigins = Object.assign({}, _otherOrigins);
        otherOrigins[name] = resolved.origins;
        _otherOrigins = otherOrigins;
        _otherValues = others;
    }

    // What went wrong resolving any theme (missing parent, cycle, broken file, unknown
    // curve); like valuesOf, ready a moment after it is first asked for
    function errorsOf(name) {
        if (_showsDraftOf(name))
            return errors;
        if (!(name in _otherErrors)) {
            Qt.callLater(_resolveOther, name);
            return [];
        }
        return _otherErrors[name];
    }

    // Where any theme's values come from (ThemeRules.origins); like valuesOf, ready a moment
    // after it is first asked for
    function originsOf(name) {
        if (_showsDraftOf(name))
            return origins;
        if (!(name in _otherOrigins)) {
            Qt.callLater(_resolveOther, name);
            return ({});
        }
        return _otherOrigins[name];
    }

    // ---- Drafts ----
    // Each theme's draft, { name: draft }: what the settings changed and did not save.
    // The shell shows a draft only while that theme is previewed; the settings always do.
    // Read from their files once, at start (drafts left from before a restart); from then
    // on this is the record, and the files follow it — so a draft emptied can simply be
    // removed, without a later read bringing it back while the removal runs.
    property var drafts: ({})
    property bool _draftsLoaded: false

    function _draftPath(name) {
        return draftsDir + "/" + name + ".json";
    }

    // Whether the active values are what the settings should show for `name`: the theme
    // shown, with its draft if it has one (it is shown with it only while previewed)
    function _showsDraftOf(name) {
        return name === themeName && (preview !== "" || !(name in drafts));
    }

    function _loadDrafts() {
        if (_draftsLoaded)
            return;
        _draftsLoaded = true;
        const read = Object.assign({}, drafts);
        for (let i = 0; i < _draftFiles.count; i++) {
            const name = _draftFiles.get(i, "fileBaseName");
            const draft = _read(_draftPath(name));
            if (draft !== null && Object.keys(draft).length > 0 && !(name in read))
                read[name] = draft;
        }
        drafts = read;
        Qt.callLater(reload);
    }

    function _writeDraft(name, draft) {
        const all = Object.assign({}, drafts);
        if (Object.keys(draft).length > 0) {
            all[name] = draft;
            _write(_draftPath(name), draft);
        } else {
            delete all[name];
            _removeFile(_draftPath(name));
        }
        drafts = all;
        _quietReload = true;
        Qt.callLater(reload);
    }

    // The theme file of `name` as it is on disk now, for changing it; null when it does
    // not parse (rewriting it would lose the user's hand edits), {} when there is none
    function _fileForEdit(name) {
        const theme = _read(_themePath(name));
        if (theme === null && _reader.text() !== "") {
            console.warn("[Theme] Not changing", _themePath(name), "— it does not parse");
            return null;
        }
        return theme ?? {};
    }

    // Whether the theme `name` has unsaved changes, in `group` or in any
    function hasDraft(name, group) {
        return group ? !!drafts[name]?.[group] : name in drafts;
    }

    // Changes one token in the draft of `name`; `value` null resets it (ThemeRules.draftWith)
    function draftToken(name, group, token, value) {
        if (Config.readOnly)
            return false;
        const file = _fileForEdit(name);
        if (file === null)
            return false;
        _writeDraft(name, ThemeRules.draftWith(drafts[name], file, group, token, value));
        return true;
    }

    // Takes back the draft's change to one token: it is as saved again
    function undraftToken(name, group, token) {
        if (Config.readOnly || !(name in drafts))
            return false;
        _writeDraft(name, ThemeRules.draftWithout(drafts[name], group, token));
        return true;
    }

    // Writes the draft of `name` into its theme file — the groups given, or all of it — and
    // keeps the rest as the draft. Built on the file as it is now, not as last read.
    function saveDraft(name, groups) {
        if (Config.readOnly || !(name in drafts))
            return false;
        const file = _fileForEdit(name);
        if (file === null)
            return false;
        const split = ThemeRules.splitDraft(drafts[name], groups);
        _writeTheme(name, ThemeRules.applyDraft(file, split.taken));
        _writeDraft(name, split.rest);
        return true;
    }

    // Throws away the draft of `name` — the groups given, or all of it
    function discardDraft(name, groups) {
        if (Config.readOnly || !(name in drafts))
            return false;
        _writeDraft(name, ThemeRules.splitDraft(drafts[name], groups).rest);
        return true;
    }

    // The draft files, listed once at start to find the drafts left from before
    FolderListModel {
        id: _draftFiles
        folder: "file://" + root.draftsDir
        nameFilters: ["*.json"]
        showDirs: false
        onStatusChanged: if (status === FolderListModel.Ready) Qt.callLater(root._loadDrafts)
    }

    // ---- Managing themes (the Themes page) ----
    // Every theme file's name, including files that do not parse, as of the last reload
    property var themeNames: []

    // Whether a theme of this name exists: a file, or the built-in default
    function themeExists(name) {
        return name === "default" || themeNames.includes(name);
    }

    // Names of the profiles whose own `appearance.theme` is `name`, and "global" when it
    // is pinned — what renaming or deleting it changes
    function setters(name) {
        return ThemeRules.retargetTheme(Profiles.profiles, Profiles.globals, name, name).changed;
    }

    // A new theme extending `base`
    function createTheme(name, base) {
        if (Config.readOnly || !ThemeRules.validThemeName(name) || themeExists(name))
            return false;
        _writeTheme(name, { extends: base || "default" });
        return true;
    }

    // A copy of the file of `source` under a new name: the same values, extending the
    // same theme
    function duplicateTheme(source, name) {
        if (Config.readOnly || !ThemeRules.validThemeName(name) || themeExists(name))
            return false;
        if (themeNames.includes(source) && !(source in themeFiles)) {
            console.warn("[Theme] Not copying", _themePath(source), "— it does not parse");
            return false;
        }
        _writeTheme(name, JSON.parse(JSON.stringify(themeFiles[source] ?? {})));
        return true;
    }

    // Points the theme `name` at a new parent, unless that would make a cycle
    function setExtends(name, base) {
        if (Config.readOnly || !(name in themeFiles))
            return false;
        if (ThemeRules.extendsCycle(name, base, themeName => themeFiles[themeName] ?? null))
            return false;
        const theme = Object.assign({}, themeFiles[name]);
        if (base === "default")
            delete theme.extends;
        else
            theme.extends = base;
        _writeTheme(name, theme);
        return true;
    }

    // Renames a theme: the new file is written first, then the themes extending it and the
    // profiles using it follow, and the old file goes. The config is backed up first.
    function renameTheme(oldName, newName) {
        if (Config.readOnly || oldName === "default" || !(oldName in themeFiles)
                || !ThemeRules.validThemeName(newName) || themeExists(newName))
            return false;
        _writeTheme(newName, themeFiles[oldName]);
        const changed = ThemeRules.renameExtends(themeFiles, oldName, newName);
        for (const name in changed)
            _writeTheme(name, changed[name]);
        _retargetProfiles(oldName, newName);
        if (oldName in drafts) {
            _writeDraft(newName, drafts[oldName]);
            _writeDraft(oldName, {});
        }
        _removeFile(_themePath(oldName));
        return true;
    }

    // Deletes a theme: the themes extending it extend its parent instead, and the
    // profiles using it fall back to the default theme. The config is backed up first.
    function deleteTheme(name) {
        if (Config.readOnly || !themeNames.includes(name))
            return false;
        const changed = ThemeRules.withoutExtends(themeFiles, name);
        for (const other in changed)
            _writeTheme(other, changed[other]);
        _retargetProfiles(name, "default");
        if (name in drafts)
            _writeDraft(name, {});
        _removeFile(_themePath(name));
        return true;
    }

    function _retargetProfiles(oldName, newName) {
        const result = ThemeRules.retargetTheme(Profiles.profiles, Profiles.globals, oldName, newName);
        if (result.changed.length === 0)
            return;
        Profiles.backUpConfig();
        console.log("[Theme] Theme", oldName, "is now", newName, "in:", result.changed.join(", "));
        Config.profiles = JSON.stringify(result.profiles);
        Config.globals = JSON.stringify(result.globals);
    }

    // Files are removed one at a time, in the order asked
    property var _removals: []

    function _removeFile(path) {
        _removals = _removals.concat([path]);
        if (!_remover.running)
            _nextRemoval();
    }

    function _nextRemoval() {
        if (_removals.length === 0)
            return;
        _remover.command = ["rm", "-f", "--", _removals[0]];
        _removals = _removals.slice(1);
        _remover.running = true;
    }

    Process {
        id: _remover
        onExited: {
            root._nextRemoval();
            Qt.callLater(root.reload);
        }
    }

    // The theme a profile uses when it is active, as the settings window edits it
    function themeOf(profileIndex) {
        return Profiles.editedValue(profileIndex, "appearance.theme") || "default";
    }

    // Names of the profiles that use the theme `name`
    function usersOf(name) {
        return Profiles.profiles.filter((profile, index) => themeOf(index) === name).map(profile => profile.name);
    }

    function _themePath(name) {
        return themesDir + "/" + name + ".json";
    }

    function _writeTheme(name, theme) {
        _write(_themePath(name), theme);
        _quietReload = true;
        Qt.callLater(reload);
    }

    FileView {
        id: _writer
        blockWrites: true
        blockAllReads: true
        printErrors: false
    }

    // Writes `value` as JSON to `path`. A FileView skips a write of the text it already
    // holds, and after a change of path it still held the previous file's (until a read
    // caught up — and reading a file that does not exist leaves it) — so a theme renamed
    // or copied, the same text under a new name, was never written. Clearing the path
    // first empties it.
    function _write(path, value) {
        _writer.path = "";
        _writer.path = path;
        _writer.reload();
        _writer.setText(JSON.stringify(value, null, 2) + "\n");
    }

    // ---- The curves library ----
    // Every theme file, { name: parsed }, as of the last reload
    property var themeFiles: ({})

    // Where the library curve `name` is used: [{ theme, role }]
    function curveUsages(name) {
        return ThemeRules.curveUsages(themeFiles, name);
    }

    // Reads the library file for changing it: null when it does not parse — rewriting it
    // would lose the user's hand edits
    function _libraryForEdit() {
        const library = _read(curvesPath);
        if (library === null && _reader.text() !== "") {
            console.warn("[Theme] Not changing", curvesPath, "— it does not parse");
            return null;
        }
        return library ?? {};
    }

    function _writeLibrary(library) {
        _write(curvesPath, library);
        Qt.callLater(reload);
    }

    // Adds or replaces the curve `name` ([x1, y1, x2, y2] or Qt's form)
    function writeCurve(name, points) {
        if (Config.readOnly || !ThemeRules.validCurveName(name) || ThemeRules.curvePoints(points) === null)
            return false;
        const library = _libraryForEdit();
        if (library === null)
            return false;
        library[name] = points;
        _writeLibrary(library);
        return true;
    }

    // Removes the curve `name`; themes still naming it fall back (ThemeRules.fallbackCurve)
    function deleteCurve(name) {
        if (Config.readOnly)
            return false;
        const library = _libraryForEdit();
        if (library === null || !(name in library))
            return false;
        delete library[name];
        _writeLibrary(library);
        return true;
    }

    // Renames the curve `oldName` and points every theme using it at the new name. A theme
    // file that does not parse is left alone, and reported.
    function renameCurve(oldName, newName) {
        if (Config.readOnly || !ThemeRules.validCurveName(newName))
            return false;
        const library = _libraryForEdit();
        if (library === null || !(oldName in library) || (newName in library))
            return false;
        const renamed = {};
        for (const name of Object.keys(library))
            renamed[name === oldName ? newName : name] = library[name];
        _writeLibrary(renamed);
        const changed = ThemeRules.renameCurveIn(themeFiles, oldName, newName);
        for (const name in changed)
            _writeTheme(name, changed[name]);
        for (let i = 0; i < _themeFiles.count; i++) {
            const name = _themeFiles.get(i, "fileBaseName");
            if (!(name in themeFiles))
                console.warn("[Theme] Not renaming curve", oldName, "in", _themePath(name), "— it does not parse");
        }
        return true;
    }

    // The theme files, listed for curveUsages and renameCurve
    FolderListModel {
        id: _themeFiles
        folder: "file://" + root.themesDir
        nameFilters: ["*.json"]
        showDirs: false
        onCountChanged: Qt.callLater(root.reload)
        onStatusChanged: if (status === FolderListModel.Ready) Qt.callLater(root.reload)
    }

    // ---- Migration: the bar's geometry moves from profiles into themes, once ----
    readonly property string _barLayoutMigration: "theme.barLayout"

    function _migrateBarLayoutIfNeeded() {
        if (!Config.ready || Config.readOnly || Config.profiles === "" || _pendingMigration !== null
                || Config.migratedKeys.includes(_barLayoutMigration))
            return;
        // Geometry from before profiles that never reached one (the per-key migration
        // marks the keys it copied)
        const legacy = Config.migratedKeys.includes("bar.layout.barHeight")
            ? undefined : Profiles.oldConfig().bar?.layout;
        const result = ThemeRules.themesFromBarLayout(Profiles.profiles, Profiles.globals, legacy,
            name => _read(_themePath(name)) !== null || _reader.text() !== "");
        if (result.themes.length > 0)
            Profiles.backUpConfig();
        _pendingMigration = result;
        // The theme files first, once their folder exists, then the profiles that pick them
        _ensureThemesDir.running = true;
    }

    property var _pendingMigration: null

    function _finishMigration() {
        const result = _pendingMigration;
        _pendingMigration = null;
        if (result === null || Config.migratedKeys.includes(_barLayoutMigration))
            return;
        for (const entry of result.themes)
            _writeTheme(entry.name, entry.theme);
        if (result.themes.length > 0) {
            // Always shown, not only in debug: a one-time change to the user's config
            console.log("[Theme] Moved the bar geometry into themes:",
                        result.themes.map(entry => entry.name + " (" + Object.keys(entry.theme.bar).join(", ") + ")").join("; "));
        }
        Config.profiles = JSON.stringify(result.profiles);
        Config.globals = JSON.stringify(result.globals);
        Config.migratedKeys = Config.migratedKeys.concat([_barLayoutMigration]);
    }

    // FileView does not create folders: the themes folder is made at start, for
    // drafts and saves, and before the migration writes into it
    Process {
        id: _ensureThemesDir
        command: ["mkdir", "-p", root.themesDir, root.draftsDir]
        onExited: root._finishMigration()
    }

    Connections {
        target: Config
        function onReadyChanged() { Qt.callLater(root._migrateBarLayoutIfNeeded) }
        function onProfilesChanged() { Qt.callLater(root._migrateBarLayoutIfNeeded) }
    }

    FileView {
        id: _reader
        blockAllReads: true
        printErrors: false
    }

    // One watcher per file read, theme or palette: an edit applies at once
    Instantiator {
        model: ScriptModel {
            values: root._watched
        }
        delegate: FileView {
            required property string modelData
            path: modelData
            watchChanges: true
            printErrors: false
            onFileChanged: Qt.callLater(root.reload)
        }
    }

    // One listing per folder looked in: a file created, removed or renamed there (a theme
    // that did not exist yet, a palette matugen writes later) reloads
    Instantiator {
        model: ScriptModel {
            values: root._watchedFolders
        }
        delegate: FolderListModel {
            required property string modelData
            folder: "file://" + modelData
            nameFilters: ["*.json"]
            showDirs: false
            onCountChanged: Qt.callLater(root.reload)
        }
    }

    // ---- Tokens ----
    // The base colours fade only while a theme change is under way: _colorsAnimating is
    // set by reload just before the new values land
    property bool _colorsAnimating: false
    property bool _quietReload: false

    Timer {
        id: _colorsAnimatingEnd
        onTriggered: root._colorsAnimating = false
    }

    component ThemeColorBehavior: Behavior {
        enabled: root._colorsAnimating
        ColorAnimation {
            duration: root.duration("themeChange")
            easing: root.curve("themeChange")
        }
    }

    readonly property var _colors: values.colors
    readonly property var _fonts: values.fonts

    // The bar's geometry, by ThemeRules.barTokens name: Theme.bar.barHeight, …
    readonly property var bar: values.bar
    // Radii, borders and spacing by kind of element: Theme.button.radius, … (the groups
    // above; docs/plans/themes-stage7.md)
    readonly property var capsule: values.capsule
    readonly property var workspace: values.workspace
    readonly property var tray: values.tray
    readonly property var popup: values.popup
    readonly property var row: values.row
    readonly property var listItem: values.listItem
    readonly property var dropdown: values.dropdown
    readonly property var powerMenu: values.powerMenu
    readonly property var button: values.button
    readonly property var saveButton: values.saveButton
    readonly property var cancelButton: values.cancelButton
    readonly property var deleteButton: values.deleteButton
    readonly property var iconButton: values.iconButton
    readonly property var pill: values.pill
    readonly property var field: values.field
    readonly property var notificationCard: values.notificationCard
    readonly property var osdToast: values.osdToast
    readonly property var osdVolume: values.osdVolume
    readonly property var osdMessage: values.osdMessage
    readonly property var tooltip: values.tooltip
    readonly property var settings: values.settings
    readonly property var calendar: values.calendar
    readonly property var checkbox: values.checkbox
    readonly property var lock: values.lock
    readonly property var border: values.border

    // ---- Animation ----
    // The profile decides how much motion there is; the theme how it looks
    readonly property real animationSpeed: Math.max(0.1, (Profiles.value("animation.speed") ?? 100) / 100)
    readonly property bool reduceMotion: Profiles.value("animation.reduceMotion") ?? false
    // Changes of colour or opacity stay with reduced motion: they do not move anything
    readonly property var _keptWhenReduced: ["hover", "state", "fade", "themeChange", "spin"]

    // How long an animation of `role` takes, in ms, at the profile's speed. With reduced
    // motion, movement takes 1 ms — not 0, so code waiting for an animation to finish
    // still sees it run. Looping animations (pulse) check reduceMotion themselves.
    function duration(role) {
        if (reduceMotion && !_keptWhenReduced.includes(role))
            return 1;
        return Math.max(1, Math.round((values.durations[role] ?? 0) / animationSpeed));
    }

    // The easing for `curve`, usually the role's name (popup has popupOpen and
    // popupClose), for an animation's `easing`: a Qt curve or one from the curves library.
    // An unknown name eases out.
    function curve(curve) {
        return _curveEasings[curve] ?? ThemeRules.curveEasing(curve, curveLibrary).easing;
    }

    // The curves library: { name: points }, see ThemeRules
    property var curveLibrary: ({})
    // Each role's easing, resolved once per reload
    property var _curveEasings: ({})

    // Typography
    readonly property string fontFamily: _fonts.family
    readonly property int fontSizeTiny: _fonts.sizeTiny
    readonly property int fontSizeXSmall: _fonts.sizeXSmall
    readonly property int fontSizeSmall: _fonts.sizeSmall
    readonly property int fontSizeBody: _fonts.sizeBody
    readonly property int fontSizeBodyLarge: _fonts.sizeBodyLarge
    readonly property int fontSizeMedium: _fonts.sizeMedium
    readonly property int fontSizeSection: _fonts.sizeSection
    readonly property int fontSizeHeading: _fonts.sizeHeading
    readonly property int fontSizeTitle: _fonts.sizeTitle
    readonly property int fontSizeDisplay: _fonts.sizeDisplay
    readonly property int fontSizeLargeDisplay: _fonts.sizeLargeDisplay
    readonly property int fontSizeXXLargeDisplay: _fonts.sizeXXLargeDisplay
    readonly property int fontSizeHero: _fonts.sizeHero

    // Backgrounds
    property color barBackground: _colors.barBackground
    ThemeColorBehavior on barBackground {}
    property color popupBackground: _colors.popupBackground
    ThemeColorBehavior on popupBackground {}
    property color surface: _colors.surface
    ThemeColorBehavior on surface {}
